{
  "manifest_version": 3,
  "name": "Stream Music Identifier",
  "version": "0.1.0",
  "description": "Identify music playing in browser streams.",
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "activeTab"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Identify stream music",
    "default_popup": "popup/popup.html"
  },
  "options_page": "options/options.html"
}